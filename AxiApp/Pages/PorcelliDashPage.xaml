<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AxiApp.Pages.PorcelliDashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="←"
                    FontSize="16"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#888888"
                    Padding="0"
                    Click="BackButton_Click"/>
            <TextBlock Grid.Column="2"
                    Text="PorcelliDash"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="White"
                    VerticalAlignment="Center"/>
            <Border x:Name="StatusBadge"
                    Grid.Column="3"
                    CornerRadius="12"
                    Padding="10,4">
                <TextBlock x:Name="StatusBadgeText"
                        FontSize="11"
                        FontWeight="Medium"/>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#1A1A1A"
                CornerRadius="12"
                Padding="24,32"
                BorderBrush="#2A2A2A"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal"
                    Spacing="100"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="8"
                        VerticalAlignment="Center">
                    <Ellipse Width="48"
                            Height="48"
                            Fill="#252525"
                            Stroke="#3A3A3A"
                            StrokeThickness="2"
                            HorizontalAlignment="Center"/>
                    <TextBlock Text="Knob 1"
                            FontSize="11"
                            Foreground="#666666"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Spacing="8"
                        VerticalAlignment="Center">
                    <Ellipse Width="120"
                            Height="120"
                            Fill="#252525"
                            Stroke="#3A3A3A"
                            StrokeThickness="2"
                            HorizontalAlignment="Center"/>
                    <TextBlock Text="Schermo principale"
                            FontSize="11"
                            Foreground="#666666"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8">
                <Button Content="Aggiorna Firmware"
                        Background="Transparent"
                        BorderBrush="#333333"
                        Foreground="#888888"
                        FontSize="12"
                        Click="UpdateFirmware_Click"/>
                <Button Content="Resetta"
                        Background="Transparent"
                        BorderBrush="#333333"
                        Foreground="#884444"
                        FontSize="12"
                        Click="FactoryReset_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                <Button Content="Cancella"
                        Background="Transparent"
                        BorderBrush="#333333"
                        Foreground="#888888"
                        FontSize="12"
                        Click="Cancel_Click"/>
                <Button Content="Applica"
                        Style="{StaticResource AccentButtonStyle}"
                        FontSize="12"
                        Click="Apply_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>