<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AxiApp.Pages.AxiDeckPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header: back + title + status ── -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="←"
                    FontSize="16"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#888888"
                    Padding="0"
                    Click="BackButton_Click"/>

            <TextBlock Grid.Column="2"
                       Text="AxiDeck"
                       FontSize="20"
                    FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <!-- Connected / disconnected badge -->
            <Border Grid.Column="3"
                    x:Name="StatusBadge"
                    CornerRadius="20"
                    Background="#1A3A1A"
                    Padding="10,4">
                <TextBlock x:Name="StatusBadgeText"
                           Text="Disconneso"
                           FontSize="11"
                           Foreground="#CC3333"/>
            </Border>
        </Grid>

        <!-- ── Physical layout of the deck ── -->
        <Border Grid.Row="2"
                Background="#1A1A1A"
                CornerRadius="12"
                Padding="24,20"
                BorderBrush="#2A2A2A"
                BorderThickness="1">

            <Grid RowSpacing="16"
                    ColumnSpacing="16"
                    HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0"
                        Grid.Column="0"
                        Spacing="6">
                    <Border Width="40"
                            Height="40"
                            Background="#252525"
                            CornerRadius="6"
                            BorderBrush="#3A3A3A"
                            BorderThickness="2"
                            HorizontalAlignment="Center"/>
                    <TextBlock Text="Btn 1"
                            FontSize="11"
                            Foreground="#666666"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="0"
                        Grid.Column="1"
                        Spacing="6">
                    <Border Width="40"
                            Height="40"
                            Background="#252525"
                            CornerRadius="6"
                            BorderBrush="#3A3A3A"
                            BorderThickness="2"
                            HorizontalAlignment="Center"/>
                    <TextBlock Text="Btn 2"
                            FontSize="11"
                            Foreground="#666666"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="0"
                        Grid.Column="2"
                        Spacing="6">
                    <Border Width="40"
                            Height="40"
                            Background="#252525"
                            CornerRadius="6"
                            BorderBrush="#3A3A3A"
                            BorderThickness="2"
                            HorizontalAlignment="Center"/>
                    <TextBlock Text="Btn 3"
                            FontSize="11"
                            Foreground="#666666"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        Spacing="6">
                    <Border Width="40"
                            Height="40"
                            Background="#252525"
                            CornerRadius="6"
                            BorderBrush="#3A3A3A"
                            BorderThickness="2"
                            HorizontalAlignment="Center"/>
                    <TextBlock Text="Btn 4"
                            FontSize="11"
                            Foreground="#666666"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        Spacing="6">
                    <Border Width="40"
                            Height="40"
                            Background="#252525"
                            CornerRadius="6"
                            BorderBrush="#3A3A3A"
                            BorderThickness="2"
                            HorizontalAlignment="Center"/>
                    <TextBlock Text="Btn 5"
                            FontSize="11"
                            Foreground="#666666"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        Spacing="6">
                    <Border Width="40"
                            Height="40"
                            Background="#252525"
                            CornerRadius="6"
                            BorderBrush="#3A3A3A"
                            BorderThickness="2"
                            HorizontalAlignment="Center"/>
                    <TextBlock Text="Btn 6"
                            FontSize="11"
                            Foreground="#666666"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        Spacing="6"
                        Margin="-50,0,0,0"
                        HorizontalAlignment="Left">
                    <Ellipse Width="48"
                            Height="48"
                            Fill="#252525"
                            Stroke="#3A3A3A"
                            StrokeThickness="2"
                            HorizontalAlignment="Center"/>
                    <TextBlock Text="Knob 1"
                            FontSize="11"
                            Foreground="#666666"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        Spacing="6"
                        Margin="0,0,-50,0"
                        HorizontalAlignment="Right">
                    <Ellipse Width="48"
                            Height="48"
                            Fill="#252525"
                            Stroke="#3A3A3A"
                            StrokeThickness="2"
                            HorizontalAlignment="Center"/>
                    <TextBlock Text="Knob 2"
                            FontSize="11"
                            Foreground="#666666"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Action mappings (stub) ── -->
        <Border Grid.Row="4"
                Background="#1A1A1A"
                CornerRadius="12"
                Padding="20"
                BorderBrush="#2A2A2A"
                BorderThickness="1"
                Margin="6">

            <StackPanel Spacing="4">
                <TextBlock Text="Mappatura bottoni"
                           FontSize="13"
                        FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Selezione un bottone od un knob in alto per modificarne l'azione assegnata."
                           FontSize="12"
                           Foreground="#444444"
                           TextWrapping="Wrap"/>
            </StackPanel>

        </Border>

        <!-- ── Bottom buttons ── -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Destructive actions left -->
            <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="7">
                <Button Content="Aggiorna Firmware"
                        Background="Transparent"
                        BorderBrush="#333333"
                        Foreground="#888888"
                        FontSize="12"
                        Click="UpdateFirmware_Click"/>

                <Button Content="Ritorna a impostazioni di fabbrica"
                        Background="Transparent"
                        BorderBrush="#333333"
                        Foreground="#884444"
                        FontSize="12"
                        Click="FactoryReset_Click"/>
            </StackPanel>

            <!-- Confirm actions right -->
            <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                <Button Content="Cancella"
                        Background="Transparent"
                        BorderBrush="#333333"
                        Foreground="#888888"
                        FontSize="12"
                        Click="Cancel_Click"/>

                <Button Content="Applica"
                        Style="{StaticResource AccentButtonStyle}"
                        FontSize="12"
                        Click="Apply_Click"/>
            </StackPanel>
        </Grid>

    </Grid>
</Page>